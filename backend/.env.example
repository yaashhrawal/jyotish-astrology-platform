# Copy this to .env and fill in values
# NEVER commit .env to git

# --- REQUIRED ---
JWT_SECRET=replace-with-64-char-random-string
DATABASE_URL=postgresql://jyotish:YOURPASSWORD@localhost:5432/jyotish

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- AI (pick one or both) ---
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# --- FILE STORAGE ---
# Where logo/photo/signature uploads land (1 MB max each)
UPLOAD_DIR=/home/ubuntu/jyotish/uploads
# Where generated PDF reports are archived
REPORTS_DIR=/home/ubuntu/jyotish/reports

# --- OPTIONAL ---
# Razorpay for subscriptions
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
