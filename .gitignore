# ── Secrets & environment ────────────────────────────────
# Never commit real env files; only *.example placeholders are tracked.
.env
backend/.env
frontend/.env
frontend/.env.*
!**/.env.example
!backend/.env.demo.example
!backend/.env.staging.example
*.pem
*.key
id_rsa*

# ── Python / backend ─────────────────────────────────────
backend/venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
backend/*.log
*.log

# ── Node / frontend ──────────────────────────────────────
frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/android/
frontend/ios/

# ── Local docs / working files (not part of the product) ──
docs/
*.pdf
*.webp
*.jpg
*.jpeg
*.png
Jyotish_Context.md
Jyotish_PRD.md

# ── OS / IDE ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Deploy artifacts ─────────────────────────────────────
deploy/*.sh.bak

testsprite_tests/tmp/config.json

mobile/node_modules/
mobile/.expo/
mobile/ios/
mobile/android/
